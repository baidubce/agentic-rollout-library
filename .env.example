# ================================
# Proxy Configuration
# ================================
# HTTP proxy settings (optional)
# Example: http://username:password@proxy-server:port
HTTP_PROXY=
HTTPS_PROXY=

# ================================
# PIP Configuration
# ================================
# Custom PIP index URL (optional, defaults to https://pypi.org/simple)
# Example for internal mirror: http://pip.example.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=

# ================================
# Miaoda MCP Server
# ================================
# Miaoda MCP server URL for API tools
# Used by api_desc, api_rag, and image_search tools
MIAODA_MCP_SERVER_URL=http://aos-mcp-sandbox.miaoda-bj-offline.baidu-int.com/v1/agentos/mcp/sse

# ================================
# LLM API Configuration
# ================================
# OpenAI API settings
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ================================
# AWS Bedrock Configuration
# ================================
# AWS Bedrock credentials for Claude models
BEDROCK_AK=your-access-key
BEDROCK_SK=your-secret-key
BEDROCK_REGION=us-west-2

# ================================
# Kubernetes Configuration (Optional)
# ================================
# Path to kubeconfig file (if not using default)
# KUBECONFIG=/path/to/kubeconfig

# ================================
# Application Configuration
# ================================
# Default namespace for K8S operations
# K8S_NAMESPACE=default

# Default container image for K8S tool execution
# K8S_IMAGE=python:3.9-slim

# ================================
# Development/Debug Settings
# ================================
# Set to 1 to enable verbose logging
# DEBUG=0

# Timeline tracking (set to 1 to enable)
# TIMELINE_ENABLED=0
